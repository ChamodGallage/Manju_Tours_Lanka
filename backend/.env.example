# ==============================================================================
# MANJU TOURS LANKA — Backend Environment Configuration Example
# Copy this file to .env and fill in your actual private credentials
# ==============================================================================

# Server Network Configuration
PORT=5001
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# Firebase Admin credentials for the backend. For local development, authenticate
# with `gcloud auth application-default login`; deployed Google environments use
# their attached service identity.
FIREBASE_PROJECT_ID=your-firebase-project-id

# Legacy Supabase settings (used only by remaining legacy routes/storage code)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
# Elevated Service Role Key (Keep strictly in backend .env; never expose to frontend)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Storage Bucket for uploads
SUPABASE_STORAGE_BUCKET=media

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=30
