# ==============================================================================
# MANJU TOURS LANKA — Backend Environment Configuration Example
# Copy this file to .env and fill in your actual private credentials
# ==============================================================================

# Server Network Configuration
PORT=5001
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# Supabase Database & Storage Configuration (Server-Side)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
# Elevated Service Role Key (Keep strictly in backend .env; never expose to frontend)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Storage Bucket for uploads
SUPABASE_STORAGE_BUCKET=media

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=30
