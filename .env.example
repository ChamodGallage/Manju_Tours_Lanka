# Company Branding & Contact Information
NEXT_PUBLIC_COMPANY_NAME="MANJU TOURS LANKA"
NEXT_PUBLIC_COMPANY_TAGLINE="Your Personal Sri Lanka Travel Planner"
NEXT_PUBLIC_COMPANY_LOCATION="Galle Road, Hikkaduwa, Southern Province, Sri Lanka"
NEXT_PUBLIC_WHATSAPP_NUMBER="+94771234567"
NEXT_PUBLIC_CONTACT_PHONE="+94771234567"
NEXT_PUBLIC_CONTACT_EMAIL="info@manjutourslanka.com"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Rate Limiting Configuration
RATE_LIMIT_MAX_REQUESTS=10
RATE_LIMIT_WINDOW_SECONDS=60

# ==============================================================================
# FIREBASE WEB CLIENT CONFIGURATION
# Copy the six values from Firebase Console > Project settings > General > Your apps > SDK setup and configuration.
# These Web App values are intended to be public; never put a service-account key here.
# ==============================================================================
NEXT_PUBLIC_FIREBASE_API_KEY="paste-your-web-app-api-key"
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="paste-your-project-auth-domain"
NEXT_PUBLIC_FIREBASE_PROJECT_ID="paste-your-project-id"
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET="paste-your-project-storage-bucket"
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID="paste-your-sender-id"
NEXT_PUBLIC_FIREBASE_APP_ID="paste-your-web-app-id"
