        "source": "/api/:path*",
        "destination": "http://localhost:5000/api/:path*",
        "regex": "^/api(?:/((?:[^/]+?)(?:/(?:[^/]+?))*))?(?:/)?$"
      }
    ],
    "fallback": []
  },
  "dynamicRoutes": [
    {
      "page": "/destinations/[slug]",
      "regex": "^/destinations/([^/]+?)(?:/)?$",
      "routeKeys": {
