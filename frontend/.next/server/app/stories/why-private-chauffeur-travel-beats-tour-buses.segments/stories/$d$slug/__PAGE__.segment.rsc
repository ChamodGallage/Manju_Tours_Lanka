12:["$","p",null,{"className":"text-base text-[#17202A] font-normal leading-relaxed","children":"When I started Manju Tours Lanka in Hikkaduwa over ten years ago, I had one clear conviction: tourists were tired of being herded into 40-seat coach buses and ushered into staged spice gardens where operators earned kickbacks on marked-up herbal oils. Travel should be personal, honest, and filled with the warm, spontaneous hospitality Sri Lanka is famous for."}]
13:["$","section","0",{"className":"space-y-4 pt-4 border-t border-[#E8E2D2]/60","children":[["$","h2",null,{"className":"text-xl sm:text-2xl font-extrabold text-[#17202A] tracking-tight","children":"1. Spontaneous Freedom on the Open Road"}],["$","p",null,{"className":"text-[#5B6770] leading-relaxed","children":"If your children spot a wild mother elephant and her baby grazing peacefully near the edge of Kaudulla reservoir, we don't have to check our watch against a tour group itinerary. We turn off the engine, roll down the windows, and let your family marvel at the sight for as long as you desire. If you want to sleep an extra hour in Nuwara Eliya, we simply adjust our departure."}],["$","div",null,{"className":"bg-[#FBF9F4] p-4 sm:p-5 rounded-2xl border border-[#E8E2D2] flex items-start gap-3 mt-4","children":[["$","div",null,{"className":"w-8 h-8 rounded-xl bg-[#E06D53]/15 text-[#E06D53] flex items-center justify-center shrink-0 mt-0.5","children":["$","$Lf",null,{"icon":{"name":"lightbulb","size":24,"node":[["path",{"d":"M15 14c.2-1 .7-1.7 1.5-2.5 1-.9 1.5-2.2 1.5-3.5A6 6 0 0 0 6 8c0 1 .2 2.2 1.5 3.5.7.7 1.3 1.5 1.5 2.5","key":"1gvzjb"}],["path",{"d":"M9 18h6","key":"x1upvd"}],["path",{"d":"M10 22h4","key":"ceow96"}]]},"className":"w-4 h-4"}]}],["$","div",null,{"children":[["$","h3",null,{"className":"font-extrabold text-xs uppercase tracking-wider text-[#0C5A70] mb-0.5","children":"Local Chauffeur Secret"}],["$","p",null,{"className":"text-xs text-[#5B6770] leading-relaxed","children":"Tell your chauffeur what music you like or ask them to play local acoustic Sinhala guitar songs for your mountain drive."}]]}]]}]]}]
14:["$","section","1",{"className":"space-y-4 pt-4 border-t border-[#E8E2D2]/60","children":[["$","h2",null,{"className":"text-xl sm:text-2xl font-extrabold text-[#17202A] tracking-tight","children":"2. Honest, Commission-Free Local Recommendations"}],["$","p",null,{"className":"text-[#5B6770] leading-relaxed","children":"We refuse to take our guests to staged commercial tourist traps. When you want to taste authentic Ceylon tea, we take you to ethical working estates. When you crave real hopper pancakes or fiery kottu roti, we guide you to clean, family-run roadside kitchens where local teachers and doctors eat."}],["$","div",null,{"className":"bg-[#FBF9F4] p-4 sm:p-5 rounded-2xl border border-[#E8E2D2] flex items-start gap-3 mt-4","children":[["$","div",null,{"className":"w-8 h-8 rounded-xl bg-[#E06D53]/15 text-[#E06D53] flex items-center justify-center shrink-0 mt-0.5","children":["$","$Lf",null,{"icon":"$13:props:children:2:props:children:0:props:children:props:icon","className":"w-4 h-4"}]}],["$","div",null,{"children":[["$","h3",null,{"className":"font-extrabold text-xs uppercase tracking-wider text-[#0C5A70] mb-0.5","children":"Local Chauffeur Secret"}],["$","p",null,{"className":"text-xs text-[#5B6770] leading-relaxed","children":"Always ask your driver where their own family eats in Kandy or Galle—that's where you will find the most delicious clay-pot curries on the island."}]]}]]}]]}]
