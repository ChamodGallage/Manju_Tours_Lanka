11:["$","div",null,{"className":"prose prose-slate max-w-none space-y-8 text-[#17202A] leading-relaxed text-sm sm:text-base","children":[["$","div",null,{"className":"p-6 rounded-2xl bg-[#0C5A70]/5 border-l-4 border-[#0C5A70] text-[#0C5A70] font-medium text-base sm:text-lg italic leading-relaxed","children":["“","With the highest leopard density in the world and the legendary Asian elephant gathering, Sri Lanka is a wildlife wonderland. Here is our guide to experiencing it ethically and intimately.","”"]}],["$","p",null,{"className":"text-base text-[#17202A] font-normal leading-relaxed","children":"Sri Lanka is one of the premier safari destinations outside of the African continent. Compact distances allow you to spot blue whales in the Indian Ocean at dawn and watch wild elephants graze around an ancient freshwater reservoir by sunset."}],[["$","section","0",{"className":"space-y-4 pt-4 border-t border-[#E8E2D2]/60","children":[["$","h2",null,{"className":"text-xl sm:text-2xl font-extrabold text-[#17202A] tracking-tight","children":"1. Yala vs. Wilpattu for Elusive Leopards"}],["$","p",null,{"className":"text-[#5B6770] leading-relaxed","children":"Yala National Park (Block 1) has the world's densest concentration of Sri Lankan leopards (Panthera pardus kotiya). Because it is famous, it can experience jeep queues at peak hours. We always send our guests with senior local drivers who choose quieter perimeter zones and dawn departures. For travelers seeking raw wilderness and fewer vehicles, Wilpattu in the northwest offers dense villu lakes and sloth bears."}],["$","div",null,{"className":"bg-[#FBF9F4] p-4 sm:p-5 rounded-2xl border border-[#E8E2D2] flex items-start gap-3 mt-4","children":[["$","div",null,{"className":"w-8 h-8 rounded-xl bg-[#E06D53]/15 text-[#E06D53] flex items-center justify-center shrink-0 mt-0.5","children":["$","$Lf",null,{"icon":{"name":"lightbulb","size":24,"node":[["path",{"d":"M15 14c.2-1 .7-1.7 1.5-2.5 1-.9 1.5-2.2 1.5-3.5A6 6 0 0 0 6 8c0 1 .2 2.2 1.5 3.5.7.7 1.3 1.5 1.5 2.5","key":"1gvzjb"}],["path",{"d":"M9 18h6","key":"x1upvd"}],["path",{"d":"M10 22h4","key":"ceow96"}]]},"className":"w-4 h-4"}]}],["$","div",null,{"children":[["$","h3",null,{"className":"font-extrabold text-xs uppercase tracking-wider text-[#0C5A70] mb-0.5","children":"Local Chauffeur Secret"}],["$","p",null,{"className":"text-xs text-[#5B6770] leading-relaxed","children":"Always opt for a dawn safari (6:00 AM entrance). Leopards are nocturnal hunters and often lounge on sun-warmed granite boulders right as the mist lifts."}]]}]]}]]}],["$","section","1",{"className":"space-y-4 pt-4 border-t border-[#E8E2D2]/60","children":[["$","h2",null,{"className":"text-xl sm:text-2xl font-extrabold text-[#17202A] tracking-tight","children":"2. The Great Elephant Gathering: Minneriya & Kaudulla"}],["$","p",null,{"className":"text-[#5B6770] leading-relaxed","children":"Between July and October, hundreds of wild Asian elephants migrate to the receding shores of Minneriya and Kaudulla reservoirs in the Cultural Triangle to feed on fresh green shoots. Watching 150 to 200 elephants interact, calves playfully splashing in the mud, is an awe-inspiring wildlife spectacle."}],["$","div",null,{"className":"bg-[#FBF9F4] p-4 sm:p-5 rounded-2xl border border-[#E8E2D2] flex items-start gap-3 mt-4","children":[["$","div",null,{"className":"w-8 h-8 rounded-xl bg-[#E06D53]/15 text-[#E06D53] flex items-center justify-center shrink-0 mt-0.5","children":["$","$Lf",null,{"icon":"$11:props:children:2:0:props:children:2:props:children:0:props:children:props:icon","className":"w-4 h-4"}]}],["$","div",null,{"children":[["$","h3",null,{"className":"font-extrabold text-xs uppercase tracking-wider text-[#0C5A70] mb-0.5","children":"Local Chauffeur Secret"}],["$","p",null,{"className":"text-xs text-[#5B6770] leading-relaxed","children":"Our chauffeurs call park rangers daily to verify whether the herd has congregated at Minneriya, Kaudulla, or Hurulu Eco Park so we take you to the exact park with the largest herd."}]]}]]}]]}],"$L20"],"$L21"]}]
