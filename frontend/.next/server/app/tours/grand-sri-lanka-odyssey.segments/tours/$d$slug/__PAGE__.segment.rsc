23:["$","section",null,{"children":["$","$L2b",null,{"itinerary":[{"day":1,"title":"Airport Arrival & Coastal Negombo Welcome","description":"Ayubowan! Meet your private Manju Tours Lanka chauffeur-guide at Bandaranaike International Airport (CMB). Transfer to your oceanfront hotel in Negombo. Relax after your flight, stroll along the fishing beach, and enjoy a fresh seafood dinner.","accommodation":"Heritance Negombo / Goldi Sands (or your preferred standard)","meals":"Dinner included"},{"day":2,"title":"Pinnawala / Dambulla Golden Cave Temple & Sigiriya","description":"Journey inland towards the Cultural Triangle. Visit the UNESCO Dambulla Cave Temple complex containing over 150 Buddha statues carved inside living rock. Arrive in Sigiriya and check into your jungle retreat.","accommodation":"Aliya Resort & Spa / Cinnamon Lodge Habarana","meals":"Breakfast & Dinner"},{"day":3,"title":"Sigiriya Rock Fortress Ascent & Minneriya Elephant Safari","description":"Early morning ascent of Sigiriya Lion Rock before the midday heat. Admire ancient frescoes and summit views. In the afternoon, board an open 4x4 safari jeep to witness the elephant gathering in Minneriya National Park.","accommodation":"Aliya Resort & Spa / Cinnamon Lodge Habarana","meals":"Breakfast & Dinner"},{"day":4,"title":"Spice Gardens of Matale & The Royal Capital of Kandy","description":"Travel south into the hills via Matale spice gardens to learn about vanilla, cardamom, and cinnamon. In Kandy, explore the Sacred Temple of the Tooth Relic during evening puja ceremonies and witness traditional Kandyan cultural dancing.","accommodation":"Earl's Regency / The Grand Kandyan","meals":"Breakfast & Dinner"},{"day":5,"title":"Peradeniya Royal Botanical Gardens & Nuwara Eliya Tea Country","description":"Tour the royal palm avenues of Peradeniya Gardens. Climb into mist-shrouded tea country. Tour a historic working tea estate, observe orthodox leaf processing, and stroll through colonial Nuwara Eliya ('Little England').","accommodation":"The Grand Hotel / Heritance Tea Factory","meals":"Breakfast & Dinner"},{"day":6,"title":"The Iconic Scenic Train to Ella & Nine Arch Bridge","description":"Board the morning train from Nanu Oya for the world's most scenic rail journey into Ella. Check in to your mountain view hotel, visit the architectural stone Nine Arch Bridge, and hike Little Adam's Peak at golden hour.","accommodation":"98 Acres Resort & Spa / Morning Dew Hotel Ella","meals":"Breakfast & Dinner"},{"day":7,"title":"Ravana Falls & Descent to Yala Wildlife Sanctuary","description":"Stop at cascading Ravana Falls before descending the southern mountain escarpment to Yala National Park. Check into your safari campsite or wilderness lodge. Enjoy a sunset dinner under starry tropical skies.","accommodation":"Cinnamon Wild Yala / Jetwing Yala","meals":"Breakfast & Dinner"},{"day":8,"title":"Dawn Leopard Safari & Coastal Drive to Mirissa","description":"Early dawn 4x4 safari with our expert wildlife tracker in search of leopards, sloth bears, and wild elephants. Continue along the picturesque southern coastline to the tropical bay of Mirissa.","accommodation":"Mandara Resort / Triple O Six Mirissa","meals":"Breakfast & Dinner"},{"day":9,"title":"Mirissa Blue Whale Cruise & UNESCO Galle Fort Heritage","description":"Morning boat trip to spot magnificent Blue Whales and spinner dolphins. In the afternoon, walk along the ocean ramparts of 17th-century Galle Dutch Fort, visiting the lighthouse and artisan craft boutiques.","accommodation":"Fort Bazaar / Le Grand Galle","meals":"Breakfast & Dinner"},{"day":10,"title":"Hikkaduwa Coastline, Colombo Highlights & Airport Departure","description":"Visit our home base in Hikkaduwa for coastal views and turtle encounters. Travel along the Southern Expressway towards Colombo for brief city highlights or shopping before drop-off at CMB Airport for your flight home.","accommodation":"Departure Transfer","meals":"Breakfast included"}]}]}]
