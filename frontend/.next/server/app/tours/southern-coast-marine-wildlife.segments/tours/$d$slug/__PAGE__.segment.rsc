14:["$","section",null,{"children":["$","$L27",null,{"itinerary":[{"day":1,"title":"Airport to Hikkaduwa Beach Oasis","description":"Arrive at CMB Airport and transfer along the Southern Expressway directly to Hikkaduwa. Unwind with fresh king coconut water by the beach.","accommodation":"Hikka Tranz by Cinnamon","meals":"Dinner"},{"day":2,"title":"Hikkaduwa Turtles, Mask Carving & Galle Fort","description":"Meet wild sea turtles on Hikkaduwa beach. Visit Ambalangoda traditional mask craft center, then spend the afternoon and sunset exploring UNESCO Galle Fort.","accommodation":"Hikka Tranz by Cinnamon","meals":"Breakfast & Dinner"},{"day":3,"title":"Mirissa Blue Whale Safari & Coconut Tree Hill","description":"Early morning boat safari to spot blue whales and dolphins. Afternoon relax at Coconut Tree Hill and Secret Beach in Mirissa.","accommodation":"Mandara Resort Mirissa","meals":"Breakfast & Dinner"},{"day":4,"title":"Yala National Park Afternoon Leopard Safari","description":"Drive along the southern curve to Yala. Embark on an afternoon 4x4 jeep safari tracking leopards, sloth bears, and herds of wild elephants.","accommodation":"Jetwing Yala","meals":"Breakfast & Dinner"},{"day":5,"title":"Scenic Coastal Return & Airport Drop-off","description":"Leisurely breakfast, stop by stilt fishermen along Koggala, and transfer via highway to CMB Airport for your flight.","accommodation":"Departure","meals":"Breakfast"}]}]}]
