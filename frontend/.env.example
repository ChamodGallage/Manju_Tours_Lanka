# ==============================================================================
# MANJU TOURS LANKA — Frontend Environment Variables Example
# Copy this file to .env.local for local development
# ==============================================================================

# Backend API URL (Configurable base URL)
NEXT_PUBLIC_API_URL="http://localhost:5000/api"
NEXT_PUBLIC_BACKEND_URL="http://localhost:5000"

# Public Supabase Project Configuration (Safe for browser / Client-side)
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="your-supabase-publishable-key"

# Company Branding & Contact Information
NEXT_PUBLIC_COMPANY_NAME="MANJU TOURS LANKA"
NEXT_PUBLIC_COMPANY_TAGLINE="Your Personal Sri Lanka Travel Planner"
NEXT_PUBLIC_COMPANY_LOCATION="Galle Road, Hikkaduwa, Southern Province, Sri Lanka"
NEXT_PUBLIC_WHATSAPP_NUMBER="+94771234567"
NEXT_PUBLIC_CONTACT_PHONE="+94771234567"
NEXT_PUBLIC_CONTACT_EMAIL="info@manjutourslanka.com"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
