rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Helper function: check if caller has admin claim
    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }

    // Site photos & gallery: public read for fast media delivery, admin-only write/delete
    match /{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
